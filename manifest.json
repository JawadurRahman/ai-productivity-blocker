{
  "manifest_version": 3,
  "name": "AI Productivity Blocker",
  "version": "1.0.0",
  "description": "A Chrome extension that uses Claude AI to determine if a site is productive and blocks it if not.",
  "permissions": [
    "webNavigation",
    "tabs",
    "storage"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "AI Productivity Blocker"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
